APP_NAME=Aula IA
APP_SESSION_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_LARGO
APP_ADMIN_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_LARGA
APP_COOKIE_SECURE=false
# Activa la publicación con scripts/configure_public.sh DOMINIO IP_DE_NPMPLUS
APP_PUBLIC=false
APP_ALLOWED_HOSTS=
APP_MAX_PDF_MB=20
APP_MAX_PDF_PAGES=40
# Cuota total de adjuntos subidos por alumno, incluidos los retirados que conserva el adulto.
APP_STUDENT_STORAGE_MB=512
# Paquetes por alumno, en una ventana de una hora. Cada paquete admite varios archivos.
APP_STUDENT_UPLOADS_PER_HOUR=12
POSTGRES_DB=aulaia
POSTGRES_USER=aulaia
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_ALEATORIA
DATABASE_URL=postgresql+psycopg://aulaia:CAMBIAR_POR_UNA_CONTRASENA_ALEATORIA@db:5432/aulaia
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AI_API_KEY=
AI_MODEL=gpt-6-luna
AI_OPENAI_INPUT_USD_PER_MILLION=0.10
AI_OPENAI_OUTPUT_USD_PER_MILLION=0.50
AI_TIMEOUT_SECONDS=90
# Ejemplo local:
# AI_PROVIDER=ollama
# AI_BASE_URL=http://192.168.1.50:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=qwen3:8b
